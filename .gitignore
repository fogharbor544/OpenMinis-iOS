# Local build outputs
build/

# Local configuration file (sdk path, etc)
local.properties

# Log/OS Files
*.log

# Android packages (the iOS app bundles signed Alpine .apk packages, see below)
*.aab
*.apk
# [T-aojit-restore] original signed Alpine packages bundled with the iOS app
!src/ios/AOJITRestore/*.apk

# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout
DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# iOS
*.ipa
*.dSYM.zip
*.dSYM

# CocoaPods
Pods/
Podfile.lock

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# macOS
.DS_Store

# Environment and secrets
.env
.env.*

# App Store Connect API keys
fastlane/.env
fastlane/appstore-keys/

# Claude Code
.claude/

# Temporary patches
deps/*.patch

# Alpine downloadable assets (ISO, rootfs, qcow2, etc.)
deps/alpine/

# iSH build outputs
deps/libs/
deps/include/
deps/resources/
deps/ish/build-ios/
deps/ish/build-native/
deps/.cache/

# FFmpeg source (downloaded by build_ffmpeg.sh). Note the trailing -6.1.2:
# a bare `deps/ffmpeg-*/` also swallowed deps/ffmpeg-patch/, which is hand
# written source that the build needs and must stay tracked.
deps/ffmpeg-6.1.2/
# Its Simulator build copy (build_ffmpeg.sh --simulator).
deps/ffmpeg-6.1.2-iphonesimulator/

# FFmpeg framework build products (regenerated by deps/build_ffmpeg.sh).
deps/frameworks/

src-bak/

# Xcode debugger state (breakpoints) — personal dev state, never track.
# "**/" because a pattern with an inner slash is anchored to this directory
# and never matched src/ios/Minis.xcodeproj/xcshareddata/xcdebugger/.
**/xcshareddata/xcdebugger/

# Python bytecode from the test/build scripts
__pycache__/

# Build-time generated Swift (from ProviderCustomization.xcconfig); regenerated each build
src/ios/Generated/

# ── Build artifacts produced by deps/ scripts — never commit binaries ──
# These are generated, not authored: rebuild them from source instead of
# tracking them (tracked binaries also leak the build machine's paths via
# debug symbols). See deps/build_lame.sh, deps/build_ffmpeg.sh,
# deps/prepare_alpine_rootfs.sh and docs for the build order.
deps/lame-build/
deps/lame-build-iphonesimulator/
deps/lame-3.100-iphonesimulator/
deps/lame-3.100/**/.libs/

# LAME autotools output (./configure writes absolute build paths into these)
deps/lame-3.100/**/Makefile
deps/lame-3.100/config.status
deps/lame-3.100/config.h
deps/lame-3.100/libtool
deps/lame-3.100/**/stamp-h1
deps/lame-3.100/**/*.la
deps/lame-3.100/**/*.lai
deps/lame-3.100/**/.libs/
deps/lame-3.100/**/.deps/

# [T-ios-aojit] AOJIT images: hundreds of MB of assembly, kept out of git
# (see deps/aot/README.md). The README and workloads are tracked.
deps/aot/*.S
deps/aot/.build/
deps/aot/.build-iphonesimulator/
